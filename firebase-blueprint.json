{
  "entities": {
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Farmer preferences, favorite crops watchlist, and weather notification toggles.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "selectedLocationId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "selectedLanguage": {
          "type": "string",
          "enum": ["en", "kn", "hi", "te", "ta"]
        },
        "favoriteCropIds": {
          "type": "array"
        },
        "alertPrefs": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "selectedLocationId", "selectedLanguage", "favoriteCropIds", "alertPrefs", "updatedAt"]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "Target market price alert configured by a farmer for a specific crop.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "cropId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "targetPrice": {
          "type": "number"
        },
        "condition": {
          "type": "string",
          "enum": ["above", "below"]
        },
        "channel": {
          "type": "string",
          "enum": ["app", "sms_demo", "whatsapp_demo"]
        },
        "enabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "cropId", "targetPrice", "condition", "channel", "enabled", "createdAt", "updatedAt"]
    },
    "FarmNote": {
      "title": "FarmNote",
      "description": "Farmer field log or harvest quality note tied optionally to a crop.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "cropId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "title", "content", "cropId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPreferences" },
      "description": "Private user preferences, favorite crop IDs, and weather alert toggles."
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/PriceAlert" },
      "description": "User-owned crop price alert rules."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/FarmNote" },
      "description": "User-owned farm and harvest log notes."
    }
  }
}
