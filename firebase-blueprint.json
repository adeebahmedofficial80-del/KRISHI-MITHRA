{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private farmer profile storing verified identity, farmer display name, geographic location (state, district, taluk, preferred mandi), saved vegetable/fruit watchlists, onboarding flags, and weather alert preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "farmerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "state": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "district": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "taluk": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "preferredMandi": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "selectedLocationId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "selectedLanguage": {
          "type": "string",
          "enum": ["en", "kn", "hi", "te", "ta"]
        },
        "favoriteCropIds": {
          "type": "array",
          "maxItems": 80
        },
        "savedVegetableIds": {
          "type": "array",
          "maxItems": 50
        },
        "savedFruitIds": {
          "type": "array",
          "maxItems": 50
        },
        "alertPrefs": {
          "type": "object"
        },
        "onboardingCompleted": {
          "type": "boolean"
        },
        "hasSeenGrandOpening": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "farmerName",
        "email",
        "state",
        "district",
        "taluk",
        "preferredMandi",
        "selectedLocationId",
        "selectedLanguage",
        "favoriteCropIds",
        "savedVegetableIds",
        "savedFruitIds",
        "alertPrefs",
        "onboardingCompleted",
        "hasSeenGrandOpening",
        "createdAt",
        "lastLoginAt",
        "updatedAt"
      ]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "Target market price alert configured by a farmer for a specific crop.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "cropId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "targetPrice": {
          "type": "number"
        },
        "condition": {
          "type": "string",
          "enum": ["above", "below"]
        },
        "channel": {
          "type": "string",
          "enum": ["app", "sms_demo", "whatsapp_demo"]
        },
        "enabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "cropId", "targetPrice", "condition", "channel", "enabled", "createdAt", "updatedAt"]
    },
    "FarmNote": {
      "title": "FarmNote",
      "description": "Farmer field log or harvest quality note tied optionally to a crop.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "cropId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "title", "content", "cropId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private owner-only farmer profile with identity, name, location, saved crops, and preferences."
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/PriceAlert" },
      "description": "User-owned crop price alert rules."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/FarmNote" },
      "description": "User-owned farm and harvest log notes."
    }
  }
}
