rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 2 && slug.size() <= 64 && slug.matches('^[a-z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidAlertPrefs(prefs) {
      return prefs is map
        && prefs.keys().hasAll(['rain', 'heavyRain', 'temperature', 'wind', 'dailyForecast'])
        && prefs.keys().hasOnly(['rain', 'heavyRain', 'temperature', 'wind', 'dailyForecast'])
        && prefs.rain is bool
        && prefs.heavyRain is bool
        && prefs.temperature is bool
        && prefs.wind is bool
        && prefs.dailyForecast is bool;
    }

    function isValidCropList(items, maxSize) {
      return items is list
        && items.size() <= maxSize
        && (items.size() == 0 || (items[0] is string && items[0].size() <= 64));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'farmerName',
          'email',
          'state',
          'district',
          'taluk',
          'preferredMandi',
          'selectedLocationId',
          'selectedLanguage',
          'favoriteCropIds',
          'savedVegetableIds',
          'savedFruitIds',
          'alertPrefs',
          'onboardingCompleted',
          'hasSeenGrandOpening',
          'createdAt',
          'lastLoginAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'farmerName',
          'email',
          'state',
          'district',
          'taluk',
          'preferredMandi',
          'selectedLocationId',
          'selectedLanguage',
          'favoriteCropIds',
          'savedVegetableIds',
          'savedFruitIds',
          'alertPrefs',
          'onboardingCompleted',
          'hasSeenGrandOpening',
          'createdAt',
          'lastLoginAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.farmerName is string
        && data.farmerName.size() >= 1
        && data.farmerName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.email == request.auth.token.email
        && data.state is string
        && data.state.size() <= 80
        && data.district is string
        && data.district.size() <= 80
        && data.taluk is string
        && data.taluk.size() <= 80
        && data.preferredMandi is string
        && data.preferredMandi.size() <= 100
        && isValidSlug(data.selectedLocationId)
        && data.selectedLanguage in ['en', 'kn', 'hi', 'te', 'ta']
        && isValidCropList(data.favoriteCropIds, 80)
        && isValidCropList(data.savedVegetableIds, 50)
        && isValidCropList(data.savedFruitIds, 50)
        && isValidAlertPrefs(data.alertPrefs)
        && data.onboardingCompleted is bool
        && data.hasSeenGrandOpening is bool
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidPriceAlert(data, userId, alertId) {
      return data.keys().hasAll(['id', 'ownerUid', 'cropId', 'targetPrice', 'condition', 'channel', 'enabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'cropId', 'targetPrice', 'condition', 'channel', 'enabled', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == alertId
        && isValidId(data.id)
        && data.ownerUid is string
        && data.ownerUid == userId
        && isValidSlug(data.cropId)
        && (data.targetPrice is int || data.targetPrice is float)
        && data.targetPrice > 0
        && data.targetPrice <= 100000
        && data.condition in ['above', 'below']
        && data.channel in ['app', 'sms_demo', 'whatsapp_demo']
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidFarmNote(data, userId, noteId) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'content', 'cropId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'title', 'content', 'cropId', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == noteId
        && isValidId(data.id)
        && data.ownerUid is string
        && data.ownerUid == userId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 2000
        && data.cropId is string
        && data.cropId.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && (!('createdAt' in existing()) ? incoming().createdAt == request.time : incoming().createdAt == existing().createdAt)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'farmerName',
          'email',
          'state',
          'district',
          'taluk',
          'preferredMandi',
          'selectedLocationId',
          'selectedLanguage',
          'favoriteCropIds',
          'savedVegetableIds',
          'savedFruitIds',
          'alertPrefs',
          'onboardingCompleted',
          'hasSeenGrandOpening',
          'createdAt',
          'lastLoginAt',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /alerts/{alertId} {
        allow get: if isValidId(userId) && isValidId(alertId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(alertId) && isOwner(userId)
          && isValidPriceAlert(incoming(), userId, alertId)
          && incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(alertId) && isOwner(userId)
          && isValidPriceAlert(incoming(), userId, alertId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['targetPrice', 'condition', 'channel', 'enabled', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(alertId) && isOwner(userId);
      }

      match /notes/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(noteId) && isOwner(userId)
          && isValidFarmNote(incoming(), userId, noteId)
          && incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(noteId) && isOwner(userId)
          && isValidFarmNote(incoming(), userId, noteId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'cropId', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(noteId) && isOwner(userId);
      }
    }
  }
}
