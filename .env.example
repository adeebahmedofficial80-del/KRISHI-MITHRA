# Server-side API Keys (NEVER expose these with VITE_ prefix or in frontend bundles)
GEMINI_API_KEY=your_gemini_api_key_here

# Official Government of India Open Government Data Platform (data.gov.in / AGMARKNET)
# Register at https://data.gov.in to obtain a free API key for daily APMC mandi prices
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
# Default resource ID: Current Daily Price of Various Commodities from Various Markets (Mandi)
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Optional: Official India Meteorological Department (IMD) API access (when provisioned)
# Open-Meteo live forecasts work automatically without a key; IMD adds official district warnings
IMD_API_BASE_URL=
IMD_API_KEY=

# Optional: Google Maps API Key for interactive APMC Mandi Map
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
